# Copy to .env (make setup does this for you). Every line is optional — these are the defaults.

# Where Postgres is. The role and database are created by scripts/setup-db.sh.
DATABASE_URL=postgres://planner:planner@127.0.0.1:5432/planner?sslmode=disable

# Where the planner listens. 127.0.0.1 keeps it private to this computer.
# Use 0.0.0.0:8080 to reach it from other devices on your network (there is no login).
PLANNER_ADDR=127.0.0.1:8080

# Where uploaded files are stored (compressed). Default: ./data
# PLANNER_DATA_DIR=/home/you/planner-data
