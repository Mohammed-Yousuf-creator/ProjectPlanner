# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Event Platform API
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ISSUER=event-platform
JWT_AUDIENCE=event-platform-users

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated browser origins. "*" is fine for local development; in
# production set the real frontend origin, e.g. https://app.example.com
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# AI features (Google Gemini)
# ---------------------------------------------------------------------------
# Paste your API key below to turn on live AI. Get one from
# https://aistudio.google.com/apikey
#
# Leave it EMPTY to run the platform fully offline: the chat assistant, the
# submission overviews and the matchmaking explanations all fall back to
# deterministic, clearly-labelled implementations. The app and its test suite
# work either way.
GEMINI_API_KEY=

# Model used for chat and summaries. gemini-2.5-flash is fast and cheap; use a
# pro model for higher-quality overviews at higher cost.
GEMINI_MODEL=gemini-2.5-flash

# Optional tuning — the defaults below are fine for local development.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_OUTPUT_TOKENS=2048
